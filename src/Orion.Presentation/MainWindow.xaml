<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Orion.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:models="using:Orion.Presentation.Models"
    xmlns:mod="using:Orion.Shared.Modules"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="NavItemTemplate" x:DataType="models:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                    <TextBlock Text="{x:Bind Label}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0">
                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="ORION AI" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.StatusItems}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StatusPillItem">
                        <Border Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush}" />
                                <TextBlock Text="{x:Bind Module}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0">
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        ToolTipService.ToolTip="Cambiar tema">
                    <FontIcon Glyph="{x:Bind ViewModel.ThemeGlyph, Mode=OneWay}" FontSize="16" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        ToolTipService.ToolTip="Configuración">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== BODY ===================== -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneToggleButtonVisible="True"
                        MenuItemsSource="{x:Bind ViewModel.MainNavItems}"
                        FooterMenuItemsSource="{x:Bind ViewModel.FooterNavItems}"
                        SelectedItem="{x:Bind ViewModel.SelectedNavItem, Mode=TwoWay}"
                        MenuItemTemplate="{StaticResource NavItemTemplate}"
                        Background="Transparent">
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <animation:NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="2" Height="30"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.Version}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind ViewModel.AiProviderText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
