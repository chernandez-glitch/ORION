<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Orion.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:models="using:Orion.Presentation.Models"
    xmlns:mod="using:Orion.Shared.Modules"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="NavItemTemplate" x:DataType="models:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                    <TextBlock Text="{x:Bind Label}" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OpenPalette_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0">
                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="ORION AI" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.StatusItems}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StatusPillItem">
                        <Border Style="{StaticResource StatusPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush}" />
                                <TextBlock Text="{x:Bind Module}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0">
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        ToolTipService.ToolTip="Cambiar tema">
                    <FontIcon Glyph="{x:Bind ViewModel.ThemeGlyph, Mode=OneWay}" FontSize="16" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        ToolTipService.ToolTip="Configuración">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== BODY ===================== -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneToggleButtonVisible="True"
                        MenuItemsSource="{x:Bind ViewModel.MainNavItems}"
                        FooterMenuItemsSource="{x:Bind ViewModel.FooterNavItems}"
                        SelectedItem="{x:Bind ViewModel.SelectedNavItem, Mode=TwoWay}"
                        MenuItemTemplate="{StaticResource NavItemTemplate}"
                        Background="Transparent">
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <animation:NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="2" Height="30"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.Version}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind ViewModel.AiProviderText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== COMMAND PALETTE (Ctrl+Shift+P) ===================== -->
        <Grid x:Name="PaletteOverlay" Grid.Row="0" Grid.RowSpan="3"
              Background="#88000000"
              DataContext="{x:Bind Palette}"
              Visibility="{x:Bind Palette.OverlayVisibility, Mode=OneWay}">
            <Border Width="640" MaxHeight="540" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,72,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="PaletteSearch" Grid.Row="0" Margin="4"
                             PlaceholderText="Escribe un comando…  (Enter ejecuta · Esc cierra)"
                             KeyDown="PaletteSearch_KeyDown"
                             Text="{x:Bind Palette.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="1" Margin="4,6,4,0"
                                Visibility="{x:Bind Palette.RecentsVisibility, Mode=OneWay}">
                        <TextBlock Text="Recientes" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="4,0,0,4" />
                        <ItemsControl ItemsSource="{x:Bind Palette.Recents, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{x:Bind}" FontSize="12" Padding="8,2"
                                            Command="{Binding DataContext.UseRecentCommand, ElementName=PaletteOverlay}"
                                            CommandParameter="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Palette.Results, Mode=OneWay}" SelectionMode="None" Margin="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PaletteItem">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="8,6"
                                            Command="{Binding DataContext.InvokeCommand, ElementName=PaletteOverlay}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=PaletteOverlay}"
                                            CommandParameter="{Binding}" ToolTipService.ToolTip="Favorito">
                                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="3" Text="{x:Bind Palette.StatusMessage, Mode=OneWay}" Margin="8,6,8,2"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
