<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Configuración" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Personaliza el asistente, la IA, la voz y la apariencia." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- Asistente -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Asistente" Style="{StaticResource CardHeaderTextStyle}" />
                    <TextBox Header="Nombre del asistente" Text="{x:Bind ViewModel.AssistantName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Palabra de activación" Text="{x:Bind ViewModel.ActivationWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Idioma (BCP-47)" Text="{x:Bind ViewModel.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- IA -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Inteligencia Artificial" Style="{StaticResource CardHeaderTextStyle}" />
                    <ComboBox Header="Proveedor" Width="300"
                              ItemsSource="{x:Bind ViewModel.AvailableProviders}"
                              SelectedItem="{x:Bind ViewModel.AiProvider, Mode=TwoWay}" />
                    <TextBox Header="Modelo" Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- Voz -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Voz" Style="{StaticResource CardHeaderTextStyle}" />
                    <TextBox Header="Micrófono" Text="{x:Bind ViewModel.Microphone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Altavoz" Text="{x:Bind ViewModel.Speaker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!-- Apariencia -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" Style="{StaticResource CardHeaderTextStyle}" />
                    <ComboBox Header="Tema" Width="300"
                              ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                              SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Rutas -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Rutas" Style="{StaticResource CardHeaderTextStyle}" />
                    <TextBox Header="Carpeta de trabajo (Workspace)" Text="{x:Bind ViewModel.WorkspacePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Ruta de VS Code" Text="{x:Bind ViewModel.VsCodePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Ruta de Claude Code" Text="{x:Bind ViewModel.ClaudeCodePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
