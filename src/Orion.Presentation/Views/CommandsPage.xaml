<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.CommandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:cmd="using:Orion.Application.Commands"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToBrushConverter x:Key="BoolBrush" />
    </Page.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Comandos" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Escribe un comando en lenguaje natural. Ej: abrir-app notepad" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 PlaceholderText="Escribe un comando y pulsa Ejecutar…"
                                 Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="Ejecutar"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RunCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.Output, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{x:Bind ViewModel.LastSucceeded, Mode=OneWay, Converter={StaticResource BoolBrush}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Comandos disponibles" Style="{StaticResource CardHeaderTextStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Commands}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="cmd:CommandDescriptor">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontFamily="Consolas" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
