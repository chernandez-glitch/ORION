<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Acerca de" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Información del producto." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon Glyph="&#xE945;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ProductName}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.Tagline}" FontStyle="Italic"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap" />

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tecnologías" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Stack}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Desarrollado por" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Company}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
