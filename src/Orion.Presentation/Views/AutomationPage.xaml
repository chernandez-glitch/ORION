<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:models="using:Orion.Presentation.Models"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:BoolToBrushConverter x:Key="BoolBrush" />
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Automatizaciones" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Flujos que ORION puede ejecutar por ti." Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning"
                 Message="{x:Bind ViewModel.Hint, Mode=OneWay}" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Automations}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AutomationItem">
                    <Grid Padding="4,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE945;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Trigger}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{x:Bind Enabled, Converter={StaticResource BoolBrush}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
