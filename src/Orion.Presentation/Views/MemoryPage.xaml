<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:Orion.Application.Memory.Dtos"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Memoria" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Lo que ORION recuerda: proyectos, rutas e historial." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Proyectos favoritos -->
                <Border Grid.Column="0" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Proyectos favoritos" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBox PlaceholderText="Nombre" Text="{x:Bind ViewModel.NewProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox PlaceholderText="Ruta" Text="{x:Bind ViewModel.NewProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Recordar proyecto" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddProjectCommand}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Projects}" SelectionMode="None" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:FavoriteProjectDto">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Rutas favoritas -->
                <Border Grid.Column="1" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Rutas favoritas" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBox PlaceholderText="Alias (p. ej. descargas)" Text="{x:Bind ViewModel.NewRouteAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox PlaceholderText="Ruta" Text="{x:Bind ViewModel.NewRoutePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Recordar ruta" HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddRouteCommand}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Routes}" SelectionMode="None" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:FavoriteRouteDto">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Alias}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Historial -->
            <Border Style="{StaticResource OrionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Historial de comandos" Style="{StaticResource CardHeaderTextStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None" MaxHeight="320">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommandHistoryDto">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind CommandName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Outcome}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ExecutedOnUtc}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
