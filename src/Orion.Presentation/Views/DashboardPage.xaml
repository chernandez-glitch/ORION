<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:mod="using:Orion.Shared.Modules"
    xmlns:dto="using:Orion.Application.Memory.Dtos"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:ModuleStatusToBrushConverter x:Key="StatusBrush" />
        <conv:BoolToBrushConverter x:Key="BoolBrush" />
        <conv:BoolToGlyphConverter x:Key="BoolGlyph" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Estado en tiempo real del asistente y del sistema." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- Fila de métricas -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" />
                        <ProgressBar Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memoria" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" />
                        <ProgressBar Value="{x:Bind ViewModel.RamPercent, Mode=OneWay}" Maximum="100" />
                        <TextBlock Text="{x:Bind ViewModel.RamDetailText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Comandos disponibles" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RegisteredCommandCount, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="registrados en el motor" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Módulos + últimos comandos -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Módulos" Style="{StaticResource CardHeaderTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mod:ModuleStatusReport">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                                 Fill="{x:Bind Status, Converter={StaticResource StatusBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Module}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource OrionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Últimos comandos" Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Text="Aún no hay comandos ejecutados."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        <ListView ItemsSource="{x:Bind ViewModel.RecentCommands, Mode=OneWay}"
                                  SelectionMode="None" MaxHeight="360">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:CommandHistoryDto">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  Glyph="{x:Bind Succeeded, Converter={StaticResource BoolGlyph}}"
                                                  Foreground="{x:Bind Succeeded, Converter={StaticResource BoolBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind CommandName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Outcome}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ExecutedOnUtc}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
