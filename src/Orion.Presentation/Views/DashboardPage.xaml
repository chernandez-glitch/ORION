<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Orion.Presentation.Models"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Estado general de ORION AI y del sistema." Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Tarjetas de métricas (grid responsive) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="210" MinItemHeight="120"
                                           MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:StatCard">
                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Left"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Value}" Style="{StaticResource StatValueTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Caption}" Style="{StaticResource StatCaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Panel de actividad -->
            <Border Grid.Column="1" Style="{StaticResource OrionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Actividad reciente" Style="{StaticResource CardHeaderTextStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityEvent">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" FontSize="11" VerticalAlignment="Top"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
