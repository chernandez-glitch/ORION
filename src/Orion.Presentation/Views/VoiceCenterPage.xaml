<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Orion.Presentation.Views.VoiceCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Orion.Presentation.Converters"
    xmlns:voice="using:Orion.Voice.Engine"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:ObjectToStringConverter x:Key="ToStr" />
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Voice Center" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Escucha, palabra de activación y reconocimiento de voz." Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <Pivot Grid.Row="1">
            <!-- ===== Control ===== -->
            <PivotItem Header="Control">
                <ScrollViewer>
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource OrionCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE720;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Nivel de micrófono" Style="{StaticResource StatCaptionTextStyle}" />
                                <ProgressBar Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}" Maximum="100" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="Escuchar" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartListeningCommand}" />
                                    <Button Content="Detener" Command="{x:Bind ViewModel.StopListeningCommand}" />
                                    <Button Content="Simular &quot;Orion&quot;" Command="{x:Bind ViewModel.TriggerWakeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OrionCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Simular habla reconocida" Style="{StaticResource CardHeaderTextStyle}" />
                                <TextBlock Text="Tras &quot;Orion&quot;, escribe el comando dictado. Se reconoce y se parsea (no se ejecuta)."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Ej: abrir-vscode"
                                             Text="{x:Bind ViewModel.SimulatedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Enviar" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SubmitCommand}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.LastResult, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ResponseMs, Mode=OneWay, Converter={StaticResource ToStr}}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ===== Dispositivos ===== -->
            <PivotItem Header="Dispositivos">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource OrionCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Micrófonos" Style="{StaticResource CardHeaderTextStyle}" />
                                <Button Content="Actualizar" FontSize="11" Padding="8,2" Command="{x:Bind ViewModel.RefreshDevicesCommand}" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind ViewModel.InputDevices, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="voice:AudioDevice">
                                        <TextBlock Text="{x:Bind Name}" Padding="0,6" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource OrionCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Altavoces" Style="{StaticResource CardHeaderTextStyle}" />
                            <ListView ItemsSource="{x:Bind ViewModel.OutputDevices, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="voice:AudioDevice">
                                        <TextBlock Text="{x:Bind Name}" Padding="0,6" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ===== Wake Word / Configuración ===== -->
            <PivotItem Header="Wake Word">
                <ScrollViewer>
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="Solo el motor Manual y el STT Simulado están disponibles: los modelos (Porcupine/OpenWakeWord/Whisper/Azure) se implementan en fases posteriores." />
                        <TextBox Header="Palabra de activación" Text="{x:Bind ViewModel.WakeWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Header="Motor de wake word" Width="300" ItemsSource="{x:Bind ViewModel.WakeEngines}" SelectedIndex="{x:Bind ViewModel.EngineIndex, Mode=TwoWay}" />
                        <StackPanel>
                            <TextBlock Text="Sensibilidad" />
                            <Slider Minimum="0" Maximum="1" StepFrequency="0.1" Value="{x:Bind ViewModel.Sensitivity, Mode=TwoWay}" />
                        </StackPanel>
                        <ComboBox Header="Proveedor STT" Width="300" ItemsSource="{x:Bind ViewModel.SttProviders}" SelectedIndex="{x:Bind ViewModel.SttIndex, Mode=TwoWay}" />
                        <ComboBox Header="Proveedor TTS" Width="300" ItemsSource="{x:Bind ViewModel.TtsProviders}" SelectedIndex="{x:Bind ViewModel.TtsIndex, Mode=TwoWay}" />
                        <ComboBox Header="Micrófono" Width="300" ItemsSource="{x:Bind ViewModel.InputDevices, Mode=OneWay}"
                                  DisplayMemberPath="Name" SelectedIndex="{x:Bind ViewModel.SelectedInputIndex, Mode=TwoWay}" />
                        <TextBox Header="Idioma (BCP-47)" Text="{x:Bind ViewModel.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveConfigCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.ConfigStatus, Mode=OneWay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ===== Historial ===== -->
            <PivotItem Header="Historial">
                <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="voice:VoiceInteraction">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind RecognizedText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ResultText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Provider}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind OccurredOnUtc, Converter={StaticResource ToStr}}" FontSize="11"
                                               HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
